{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": { "id": { "type": "integer" }, "first_name": { "type": "string" }, "last_name": { "type": "string" }, "vehicles": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "properties": { "Boat": { "type": "array", "items": { "type": "string" } } } } ] } }, "favorite": { "type": "array", "x-asterix-type": "multiset", "items": { "type": "string" } }, "friends": { "type": "object", "properties": { "Best_friend": { "type": "string" }, "Number_friends": { "type": "integer" }, "Alias": { "type": "array", "items": { "oneOf": [ { "type": "integer" }, { "type": "string" }, { "type": "object", "properties": { "Animal": { "type": "string" }, "Toy": { "type": "boolean" } } } ] } } } }, "children": { "type": "null" } }, "required": [ "id" ] }