/*
 * Description    : records with different fields
 * Success        : Yes
 */

use test;
insert into D ([{"id": 1, "a": "x"}, {"id": 2, "b": 2}, {"id": 3, "a": "y", "b": 3}]);
-- 500 groups; obj is missing for the 20 ids divisible by 997, which fall in 20 different groups
insert into E (
  select value {"id": i, "g": i % 500,
                "obj": case when i % 997 = 0 then missing
                            when i % 3 = 0 then {"a": i}
                            when i % 3 = 1 then {"b": "x"}
                            else {"a": i, "c": true} end}
  from range(1, 20000) i
);
