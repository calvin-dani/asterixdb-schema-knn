/*
 * Description    : array-schema per group under the same memory skips the missing items
 * Success        : Yes
 */

set `compiler.groupmemory` "128KB";
set `compiler.sortmemory` "128KB";
use test;
select count(*) as groups, sum(case when t.s is null then 1 else 0 end) as null_groups,
       sum(case when object_length(t.s.properties) = 3 then 1 else 0 end) as three_field_groups
from (select k, array_schema((select value x.e.obj from g x)) as s from E e group by e.g as k group as g) t;
